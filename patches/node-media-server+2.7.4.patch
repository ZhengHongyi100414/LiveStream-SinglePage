+function getFFmpegVersion() {
+  try {
+    const result = require('child_process').execSync('/usr/bin/ffmpeg -version 2>/dev/null | head -1').toString().trim();
+    const match = result.match(/ffmpeg version (\S+)/);
+    return match ? match[1] : 'unknown';
+  } catch (e) {
+    return 'unknown';
+  }
+}
+
+function getFFmpegUrl() {
+  return '/usr/bin/ffmpeg';
+}
+
 module.exports = {
   generateNewSessionID,
   verifyAuth,
   genRandomName,
+  getFFmpegVersion,
+  getFFmpegUrl,
 };
